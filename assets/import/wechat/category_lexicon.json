{
  "schemaVersion": 1,
  "source": "wechat",
  "locale": "zh-CN",
  "normalization": {
    "trim": true,
    "fullWidthToHalfWidth": true,
    "asciiLowercase": true,
    "collapseWhitespace": true
  },
  "defaultMatchMode": "containsAny",
  "conflictPolicy": "unresolved",
  "fallbackRules": [
    {
      "id": "income_fallback_other",
      "direction": "income",
      "priority": -100,
      "categoryPath": [
        "其他"
      ],
      "reason": "unmatched_or_conflict",
      "warningCode": "category_fallback"
    },
    {
      "id": "expense_fallback_other",
      "direction": "expense",
      "priority": -100,
      "categoryPath": [
        "其他"
      ],
      "reason": "unmatched_or_conflict",
      "warningCode": "category_fallback"
    }
  ],
  "directRules": [
    {
      "id": "income_refund",
      "direction": "income",
      "priority": 1000,
      "conditions": {
        "logic": "any",
        "items": [
          {
            "field": "transactionType",
            "operator": "contains",
            "value": "退款"
          },
          {
            "field": "status",
            "operator": "equals",
            "value": "已全额退款"
          }
        ]
      },
      "categoryPath": [
        "其他"
      ],
      "reason": "refund_income"
    }
  ],
